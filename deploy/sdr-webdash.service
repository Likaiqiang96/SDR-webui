[Unit]
Description=SDR Web Dashboard (RSP1, C++ server, port 8095)
After=network-online.target sdrplay.service
Wants=network-online.target
Requires=sdrplay.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__/cpp
ExecStart=__INSTALL_DIR__/cpp/sdrwebd --port 8095
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
